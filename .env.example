# API base URL (no trailing slash)
EXPO_PUBLIC_API_URL=https://www.funsa.online/api/v1

# Mock auth — skips API calls for login/register OTP (any 6-digit code works)
# Defaults to ON in development. Set to false when the API is ready:
EXPO_PUBLIC_USE_MOCK_AUTH=true

# Mock lender products — list / add / edit / delete stored on device (no API)
# Defaults to ON in development. Set to false when the API is ready:
EXPO_PUBLIC_USE_MOCK_PRODUCTS=true
